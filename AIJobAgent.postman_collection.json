{
  "info": {
    "name": "AI Job Agent Backend",
    "description": "Personal AI job assistant. Base URL http://localhost:8080/api/v1 . Single-device JWT via /auth/register. No login; PIN/biometric local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Device",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"deviceId\":\"test-device-001\",\"deviceName\":\"Pixel Emulator\"}" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }
          }
        },
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/health" }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        { "name": "Get Profile", "request": { "method": "GET", "url": "{{baseUrl}}/profile", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } },
        { "name": "Put Profile", "request": { "method": "PUT", "url": "{{baseUrl}}/profile", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\"id\":\"singleton\",\"fullName\":\"John Doe\",\"email\":\"john@example.com\",\"phoneNumber\":\"+971500000000\",\"linkedInUrl\":\"https://linkedin.com/in/johndoe\",\"gitHubUrl\":\"https://github.com/johndoe\",\"resumeText\":\"Kotlin, Spring Boot\",\"preferredCountries\":[\"UAE\",\"Germany\"],\"preferredJobTitles\":[\"Android\",\"Backend\"],\"skills\":[\"Kotlin\",\"Java\",\"Spring Boot\",\"Android\"]}" } } },
        { "name": "Upload Resume", "request": { "method": "POST", "url": "{{baseUrl}}/profile/resume", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] } } }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        { "name": "List Jobs", "request": { "method": "GET", "url": "{{baseUrl}}/jobs?q=android&minMatch=0&page=0&size=20", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } },
        { "name": "High Match", "request": { "method": "GET", "url": "{{baseUrl}}/jobs/high-match", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } },
        { "name": "Scan Jobs", "request": { "method": "POST", "url": "{{baseUrl}}/jobs/scan", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\"query\":\"Android\",\"preferredCountries\":[\"UAE\"],\"preferredTitles\":[\"Android\"],\"skills\":[\"Kotlin\"]}" } } },
        { "name": "Get Job By ID", "request": { "method": "GET", "url": "{{baseUrl}}/jobs/{{jobId}}", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } }
      ]
    },
    {
      "name": "AI",
      "item": [
        { "name": "Analyze Job", "request": { "method": "POST", "url": "{{baseUrl}}/ai/analyze/{{jobId}}", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } },
        { "name": "Cover Letter", "request": { "method": "POST", "url": "{{baseUrl}}/ai/cover-letter/{{jobId}}", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } },
        { "name": "Interview Prep", "request": { "method": "POST", "url": "{{baseUrl}}/ai/interview-prep/{{jobId}}", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } }
      ]
    },
    {
      "name": "Applications & Dashboard",
      "item": [
        { "name": "List Applications", "request": { "method": "GET", "url": "{{baseUrl}}/applications", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } },
        { "name": "Create Application (PENDING_APPROVAL)", "request": { "method": "POST", "url": "{{baseUrl}}/applications", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\"jobId\":\"{{jobId}}\",\"status\":\"PENDING_APPROVAL\"}" } } },
        { "name": "Update Status to APPLIED", "request": { "method": "PATCH", "url": "{{baseUrl}}/applications/{{applicationId}}/status", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\"status\":\"APPLIED\"}" } } },
        { "name": "Dashboard Stats", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/stats", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "protocolProfileBehavior": {}
}
